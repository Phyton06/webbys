---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Webbys · Administración">
  <main class="entry">
    <div class="entry-brand">
      <span class="entry-mark" aria-hidden="true">W</span>
      <span>webbys<span class="entry-period">.</span></span>
    </div>
    <h1>Panel de administración<br />para tu barbería.</h1>
    <p class="entry-copy">Administra Webby's Barbershop desde un solo lugar.</p>
    <a class="entry-link" href="/login/">Iniciar sesión <span aria-hidden="true">↗</span></a>
  </main>
</AppLayout>

<style>
  .entry {
    display: grid;
    min-height: 100svh;
    align-content: center;
    justify-items: start;
    width: min(100% - 3rem, 42rem);
    margin-inline: auto;
    padding-block: var(--space-12);
  }

  .entry-mark {
    display: grid;
    width: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-accent);
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .entry-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .entry-period {
    color: var(--color-accent);
  }

  h1 {
    max-width: 12ch;
    margin: var(--space-12) 0 0;
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .entry-copy {
    max-width: 36ch;
    margin: var(--space-5) 0 var(--space-8);
    color: var(--color-ink-muted);
  }

  .entry-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: var(--space-4);
    padding: 0 var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--color-accent-action);
    color: var(--color-accent-ink);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .entry-link:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  @media (min-width: 48rem) {
    .entry {
      width: min(100% - 6rem, 64rem);
    }
  }
</style>
