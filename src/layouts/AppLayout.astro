---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Administración de la barbería Webbys.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#101113" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/webbys.svg" />
    <link rel="apple-touch-icon" href="/icons/webbys-192.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
