---
import '../styles/tokens.css';
import { InstallPrompt } from '../components/InstallPrompt';
import { sitePath } from '../lib/site-path';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Administración de la barbería Webbys.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#101113" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content={description} />
    <link rel="manifest" href={sitePath('/manifest.webmanifest')} />
    <link rel="icon" type="image/png" sizes="512x512" href={sitePath('/icons/webbys-512.png')} />
    <link rel="apple-touch-icon" href={sitePath('/icons/webbys-192.png')} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <InstallPrompt client:load />
  </body>
</html>
